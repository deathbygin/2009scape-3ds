; One matrix transform per vertex, colour passed through.

.fvec mvp[4]

.constf myconst(0.0, 1.0, 0.00392156862, 0.0)
.alias ones   myconst.yyyy
.alias inv255 myconst.zzzz

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	mul outclr, inv255, inclr
	end
.end
